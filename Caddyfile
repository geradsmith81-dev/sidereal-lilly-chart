# Caddy settings for The Sidereal Oracle (used only by the Dockerfile, on Render).
# Render provides the https:// security certificate itself, so Caddy only speaks plain http inside the server.
{
	admin off
	auto_https off
}

:{$PORT:10000} {
	encode gzip

	# Google Play's proof that the Android app and this website belong together. The file lives in
	# web/well-known/ (no dot), because GitHub's drag-and-drop upload skips folders whose names start with a dot.
	handle /.well-known/assetlinks.json {
		root * "{$SITE_ROOT:/srv/app}/web/well-known"
		rewrite * /assetlinks.json
		header Content-Type application/json
		file_server
	}

	# The app itself (Streamlit). Its live connection (WebSocket) passes through automatically.
	@app path /app /app/*
	handle @app {
		reverse_proxy 127.0.0.1:8501
	}

	handle /privacy {
		root * "{$SITE_ROOT:/srv/app}/web"
		rewrite * /privacy.html
		file_server
	}

	# Everything else: the welcome page, icons, manifest and offline page.
	handle {
		root * "{$SITE_ROOT:/srv/app}/web"
		header /sw.js Cache-Control "no-cache"
		file_server
	}
}
